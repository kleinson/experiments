{
  "name": "seatreasures",
  "version": "1.0.0",
  "description": "An open-source interactive cowrie natural-history experiment: a 3D shell, anatomy plates and a sourced evidence manifest.",
  "license": "MIT",
  "author": "Andreas Kleiner",
  "repository": {
    "type": "git",
    "url": "https://github.com/kleinson/experiments.git",
    "directory": "SeaTreasures"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "sync:ios": "node scripts/sync-ios.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test:ios": "npm run sync:ios && bash ios/Scripts/test-core.sh",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "species": "node scripts/build-species.mjs && prettier --write data/species.json data/claims.json",
    "ranges": "node scripts/build-ranges.mjs && prettier --write data/ranges.json data/claims.json"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.2",
    "d3-geo": "^3.1.1",
    "oxlint": "^1.69.0",
    "prettier": "^3.6.2",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "world-atlas": "^2.0.2"
  }
}
