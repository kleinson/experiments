{
  "name": "kleinson-experiments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "node --experimental-strip-types --test shell-remembers/tests/*.test.ts",
    "test:e2e": "playwright test",
    "sync:ios": "node scripts/sync-ios.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test:ios": "npm run sync:ios && bash shell-remembers/ios/Scripts/test-core.sh",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
